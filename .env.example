# Copie ce fichier en ".env" et remplis tes vraies clés (ne JAMAIS committer .env)
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here

# Mets à "true" tant que tu testes, pour ne jamais passer d'ordre réel
DRY_RUN=true

# Crée un bot via @BotFather sur Telegram pour obtenir le token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Ton chat_id (voir instructions dans src/telegram_notifier.py)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
